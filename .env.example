NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/debre_birhan_market
# Set DATABASE_SSL=true when connecting to a hosted database's external URL.
# (Render's *.render.com external URLs are detected automatically.)
DATABASE_SSL=
# Required in production: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Registered account to promote to admin when migrations run.
ADMIN_EMAIL=
# Only needed if the API is called from a different website (comma separated).
FRONTEND_ORIGIN=
PAYMENTS_MODE=manual
LOCAL_DELIVERY_FEE_ETB=100
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
